# LLM: gemini | openai | anthropic (default: first matching API key below)
# LLM_PROVIDER=gemini

# Google Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=...

# Optional; default gemini-2.5-flash
# GEMINI_MODEL=gemini-2.5-flash

# OpenAI — https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-proj-...

# Optional; default gpt-4o-mini
# OPENAI_MODEL=gpt-4o-mini

# Anthropic — https://console.anthropic.com/
# ANTHROPIC_API_KEY=sk-ant-...

# Required for user-scoped keys (sk-ant-usr-...); find in Anthropic Console → Workspace settings
# ANTHROPIC_WORKSPACE_ID=wrkspc_...

# Neon Postgres connection string — https://neon.tech/
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Optional; default is a fast Claude model
# CLAUDE_MODEL=claude-haiku-4-5-20251001
